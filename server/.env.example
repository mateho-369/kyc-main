# =============================================================================
#  BACKEND  .env   (このファイルを server/.env にコピーする)
#  cd server && npm run env:setup   でコピー＋秘密キー自動生成ができる
# =============================================================================
# 読み込み元: server/config/db.js（アプリ）と server/config/config.js（sequelize-cli）
# が「同じ優先順位」で読む。ズレると「migrate したのにカラムが無い」になる。
#   MYSQL_* が最優先 → 無いときだけ DB_* → どちらも無ければ既定値
# どちらか一方だけを設定すること。両方書くと MYSQL_* が勝って紛らわしい。
# DB_* 系で統一したい場合の記述例（MYSQL_* を消してから使う）:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=safevideo
# DB_USER=root
# DB_PASSWORD=
# テスト実行時のみ別データベース（npm run test 系）
# TEST_DB_NAME=safevideo_test

# -----------------------------------------------------------------------------
# 実行モード
# -----------------------------------------------------------------------------
# development: SQL ログが出る・sync(alter) が走る・シードが許可される
# production : シード（ダミーアカウント）は原則 abort する
NODE_ENV=development
LOG_LEVEL=info

# API の待ち受けポート。フロントの REACT_APP_API_URL と揃えること。
#   server/.env で npm start するだけ → 5000
#   docker-compose を使う        → ホスト側 5002（ compose は 5002:5000 ）
PORT=5000

# -----------------------------------------------------------------------------
# MySQL  ★必須（SSO はユーザー行を書けなければ 503 で落ちる）
# -----------------------------------------------------------------------------
# Windows のネイティブ MySQL なら 127.0.0.1 を推奨（localhost は ::1 に解決されることがある）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=safevideo
MYSQL_USER=root
MYSQL_PASSWORD=

# -----------------------------------------------------------------------------
# Shared Firebase project (Admin SDK service account) ★required
# For local Sharegram/KYC testing, use the same dedicated Firebase test project on both sides.
# -----------------------------------------------------------------------------
# Firebase Console → プロジェクト設定 → サービスアカウント → 「新しい秘密鍵」の JSON を展開して貼る。
# FIREBASE_PRIVATE_KEY は改行を \n にエスケープすること（JS にエスケープなしで渡すと壊れる）。
#   PowerShell で読む:
#     node -e "const k=require('./sa.json');console.log('FIREBASE_PRIVATE_KEY=
# 秘密鍵JSONの残り項目（admin.credential.cert() はこの3つ無くても動く）
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
# FIREBASE_CLIENT_X509_CERT_URL=
# デプロイ名のラベル（ログ・エラー報告に載るだけ）
# DEPLOYMENT_ENVIRONMENT=local'+JSON.stringify(k.private_key))"
FIREBASE_PROJECT_ID=sharegram-kyc-test
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# 秘密鍵JSONの残り項目（admin.credential.cert() はこの3つ無くても動く）
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
# FIREBASE_CLIENT_X509_CERT_URL=
# デプロイ名のラベル（ログ・エラー報告に載るだけ）
# DEPLOYMENT_ENVIRONMENT=local

# トークン検証対象のプロジェクト。Sharegram の ID token と一致しない場合は
# ここを直すのではなく、検証側を止める（一致しない_token は 400 で落とす設計）。
# FIREBASE_AUTH_URI=https://identitytoolkit.googleapis.com/googlev1.identity:idpSignin
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
# FIREBASE_CLIENT_ID=
# FIREBASE_DATABASE_URL=

# 一時的に Firebase を無効化して起動だけ確認する（true にすると SSO は 503 になる。
# 偽ユーザーにはフォールバックしない）。
DISABLE_FIREBASE=false

# -----------------------------------------------------------------------------
# JWT / セッション
# -----------------------------------------------------------------------------
# 32バイト以上のランダム値。 npm run env:setup が自動生成する。
# 本番で JWT_SECRET を回し直すと全アクセストークンが無効になる（ログアウト相当）。
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# -----------------------------------------------------------------------------
# Sharegram 口座API（SSO の表示名・avatar を補完する任意機能）
# -----------------------------------------------------------------------------
# 未設定でも SSO は動く（claims だけでユーザーを作る）。名前が「email の@の前」に
# なるのはこの補完が走っていないとき。
SHAREGRAM_ACCOUNT_API_URL=
SHAREGRAM_ACCOUNT_PATH=/accounts/search
SHAREGRAM_ACCOUNT_TIMEOUT_MS=5000

# ホスト側の API 既定（アカウント検索とは別物。上流の API ベース URL）
SHAREGRAM_API_URL=
SHAREGRAM_API_TIMEOUT_MS=5000
# 機械間呼び出しの API key（カンマ区切りで複数）。設定した瞬間にその key が
# role='admin' になるため、機密として扱う。手元では空にすること。
SHAREGRAM_API_KEYS=
SHAREGRAM_API_KEY=
# 認証トークンの発行元/audience（既定は Google SecureToken を検証）
SHAREGRAM_ISSUER=
SHAREGRAM_AUDIENCE=
SHAREGRAM_JWKS_URI=
SHAREGRAM_SECRET=
# Firebase 側から来る webhook の共有シークレット
FIREBASE_WEBHOOK_SECRET=
APP_CLIENT_ID=

# Webhook 署名（Sharegram → このサーバー）。使わないなら空のまま。
SHAREGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Webhook（このサーバー → Sharegram）: 出演者の作成/更新/承認/削除を通知する
# -----------------------------------------------------------------------------
# KYC と Sharegram の DB は別物。これを設定しないと、KYC で登録した出演者は
# Sharegram 側の DB に存在しないまま。URL 未設定なら何も送らない（起動ログに表示）。
# 受信先は Sharegram バックエンドの API ルート（ローカル例）:
#   KYC_WEBHOOK_URL=http://api.local-og.com:8000/v2/kyc/webhook
KYC_WEBHOOK_URL=
# Sharegram の .env の KYC_WEBHOOK_SECRET と「同じ値」。上の SHAREGRAM_WEBHOOK_SECRET
# （逆方向）とは別の値にすること。生成:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_WEBHOOK_SECRET=
# 送るイベント（省略時は全部）:
#   performer.created, performer.updated, performer.approved, performer.deleted, document.verified
KYC_WEBHOOK_EVENTS=
KYC_WEBHOOK_TIMEOUT_MS=5000
# 検証スキップは事故る。開発での疎通確認だけ一時的に:
SKIP_WEBHOOK_VERIFICATION=false

# -----------------------------------------------------------------------------
# CORS / フロント URL
# -----------------------------------------------------------------------------
# カンマ区切り。このアプリの withCredentials（Cookie）を使う認証では、
# '*' にするとブラウザが応答を弾く。具体的 origin を書くこと。
CORS_ORIGIN=http://localhost:3000,http://localhost:3300
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3300
FRONTEND_URL=http://localhost:3300
SHAREGRAM_ALLOWED_ORIGINS=http://localhost:3000
SHAREGRAM_ALLOWED_CALLBACK_HOSTS=localhost,127.0.0.1,share-gram.com
COOKIE_DOMAIN=
FORCE_HTTPS=false
# 厳格モード: 上のリストに無い origin を弾く（既定 true）。CORS の調査ログ:
STRICT_CORS=true
CORS_DEBUG=false

# -----------------------------------------------------------------------------
# URL 形式で一括指定したい場合（上の MYSQL_* より優先度は低い: ここを設定して
# いないなら MYSQL_* を書くこと。両方あると分かりにくい）
# DATABASE_URL=mysql://root@127.0.0.1:3306/safevideo
# CLI/app 共通の接続タイムアウト（ms）
# DB_CONNECT_TIMEOUT_MS=60000

# ログ（LOG_LEVEL=debug のときのファイル出力先）と、フロントに返す版数表示
LOG_DIR=logs
VERSION=1.0.0

# ファイル保存先（出演者の証明書）
# -----------------------------------------------------------------------------
# 既定は server/uploads。Windows でも相対で動く。
UPLOAD_DIR=uploads

# -----------------------------------------------------------------------------
# Redis（任意。無効でも SSO・認証は動く）
# -----------------------------------------------------------------------------
ENABLE_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TOKEN_DB=1
REDIS_SSO_DB=2
REDIS_AUTH_DB=3
REDIS_TEST_DB=4

# -----------------------------------------------------------------------------
# 各種機能フラグ（既定値のままが安全）
# -----------------------------------------------------------------------------
ENABLE_RATE_LIMITING=true
ENABLE_SLOW_DOWN=true
ENABLE_AUDIT_LOGGING=true
ENABLE_SESSION_MANAGEMENT=true
WS_ENABLED=false
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL=30000
REQUIRE_EMAIL_VERIFICATION=false

# 暗号化（書類URL・Webhook 送信値など）。64hex 必要。 env:setup が生成する。
ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# シード（cd server && npm run seed）
# -----------------------------------------------------------------------------
# 0001: テスト用アカウントを作る。既定値:
#   user@example.com  / user123    role=user
#   admin@example.com / admin123   role=admin
# 上書きしたいときだけ設定する（設定しなくても作られる）。
# SEED_USER_EMAIL=user@example.com
# SEED_USER_PASSWORD=
# SEED_USER_NAME=user
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=admin
#
# 0002: Sharegram の「実アカウント」を admin に昇格（SSO が作るのは role=user）。
#   approve / /api/v1 / 管理ナビを使う人が対象。未設定なら何もしない。
SEED_ADMIN_EMAIL=
# SEED_ADMIN_ROLE=admin
# SEED_ADMIN_NAME=Makara
#
# 0003: ダッシュボードに見せるためのデモ出演者（user に2件・admin に2件）。
#   空のテーブルで動作確認するのが面倒なだけ。本番DBでは作らないこと。
SEED_DEMO_DATA=true
# SEED_DEMO_OWNER_EMAILS=user@example.com,admin@example.com
#
# 本番でどうしても実行する必要がある場合のみ（ダミー認証情報が実DBに入る）
SEED_ALLOW_INSECURE=false
# seed:undo は既定では「消せる物」を報告するだけ。本当に消すときだけ true。
SEED_UNDO_DELETE=false

# -----------------------------------------------------------------------------
# ⚠️ 常に空/false のままにしておくフラグ（設定すると認証を素通りする）
# -----------------------------------------------------------------------------
# 検索で見つかるように全部ここに置いてあるが、行を有効にしないこと。
# SYSTEM_API_KEYS=           : 設定された key は role='admin' として扱われる。
#                              本番の機械間通信専用。手元の .env には入れない。
# SHAREGRAM_API_KEYS=        : 同上（こちらが本来の入口）
# CSRF_DEV_BYPASS=           : CSRF 検証を止める
# SKIP_VALIDATION=           : express-validator を止める
# DISABLE_DB=                : true にすると DB 使わずダミー応答。SSO は永続化できない
# TEST_MODE_API_KEY=         : 一時的なテストモード（有効期間・IP許可・上限）
# TEST_MODE_IP_WHITELIST=
# TEST_MODE_MAX_REQUESTS=
# TEST_MODE_DURATION=
# ENABLE_TEST_BACKDOOR=      : 名前どおりの裏口。TEST_BACKDOOR_PASSWORD と併用すると
# TEST_BACKDOOR_PASSWORD=      認証を素通りする。いずれも設定しない
