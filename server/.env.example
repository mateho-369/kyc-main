# Local backend only. Never use production credentials for local testing.
# npm run env:setup generates blank local session/encryption secrets, without seeds.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kyc_local
MYSQL_USER=kyc_local
MYSQL_PASSWORD=
# Only used by optional compose.local.yml; never use this root account for the app.
LOCAL_MYSQL_ROOT_PASSWORD=
TEST_DB_NAME=kyc_local_test
# Schema is migration-only, including development. Never auto-sync/alter.
DISABLE_DB=false
DISABLE_FIREBASE=false
# Same real, authorized TEST project as Sharegram and frontend. Never Emulator.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=
WEBHOOK_ENCRYPTION_KEY=
JWT_ISSUER=safevideo-kyc
JWT_AUDIENCE=safevideo-app
# CRA rewrites Origin to its loopback proxy target in local development.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5000
STRICT_CORS=true
FORCE_HTTPS=false
# Local Redis is recommended; production token service requires working Redis.
ENABLE_REDIS=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TOKEN_DB=3
# Optional authorized Sharegram account enrichment; blank means not configured.
SHAREGRAM_ACCOUNT_API_URL=
SHAREGRAM_ACCOUNT_PATH=/accounts/search
# V2 decision delivery: start worker only with approved receiver + separate secret.
KYC_DECISION_WEBHOOK_URL=
KYC_DECISION_WEBHOOK_ALLOWED_HOSTS=
KYC_DECISION_WEBHOOK_SECRET=
# Legacy V1 notifications remain disabled unless explicitly configured/reviewed.
KYC_WEBHOOK_URL=
KYC_WEBHOOK_SECRET=
