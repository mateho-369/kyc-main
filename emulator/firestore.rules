rules_version = '2';
// Firebase Emulator 専用（firebase.emulator.json からのみ参照）。本番の firestore.rules とは別物で、デプロイされない。
// アプリのクライアントは Firestore を読み書きしない（サーバーは Admin SDK でルールを通らない）ので全拒否でよい。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
