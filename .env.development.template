# Development Environment Variables for KYC Frontend
# This is a template for local development. Copy to .env.local and update values.

# API Endpoint - Local Backend
REACT_APP_API_URL=http://localhost:5002/api
REACT_APP_API_BASE_URL=http://localhost:5002/api

# Firebase Emulator project. This MUST match firebase.emulator.json's demo-kyc-local.
REACT_APP_FIREBASE_API_KEY=fake-api-key-for-local-emulator
REACT_APP_FIREBASE_AUTH_DOMAIN=demo-kyc-local.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=demo-kyc-local
REACT_APP_FIREBASE_STORAGE_BUCKET=demo-kyc-local.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:local-emulator
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Firebase Emulator
REACT_APP_USE_FIREBASE_EMULATOR=true
REACT_APP_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
REACT_APP_FIREBASE_FIRESTORE_EMULATOR_URL=http://127.0.0.1:8080

# Features
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_MOCK_API=true

# Security (Development - Relaxed)
REACT_APP_SECURE_COOKIES=false
REACT_APP_REQUIRE_HTTPS=false

# KYC Settings
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf
REACT_APP_SESSION_TIMEOUT=3600000

# Build Configuration
GENERATE_SOURCEMAP=true
REACT_APP_ENV=development

# Notes:
# 1. For production Firebase project access, contact the admin team
# 2. Firebase Emulator provides full auth functionality without real accounts
# 3. Mock API mode allows frontend development without backend
# 4. Copy actual values from .env.production if testing production features