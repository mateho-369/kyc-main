# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Production
/build

# Docker volumes
mysql-data

# Misc
.DS_Store

# 環境変数（機密情報）
# すべての .env 系を既定で除外し、値を伏せたテンプレートだけを明示的に許可する。
# 以前は .env.production / .env.staging / server/.env.backup* が除外対象から漏れており、
# DBパスワード・JWT秘密鍵・Firebase秘密鍵・Sharegram APIキーが
# コミット対象に含まれていた。
.env
.env.*
**/.env
**/.env.*

# 値を伏せたテンプレートのみ許可
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example
!.env.*.template
!**/.env.*.template

# 認証情報を含む配布物
*-credentials.md
*-credentials.html
*-credentials.pdf
**/serviceAccount*.json
**/firebase-credentials.json
*.pem
*.key
*.p12
*.pfx

# macOS のリソースフォーク（サーバーに紛れ込んでいた）
._*
**/._*

# 使い捨ての運用スクリプト（本番の root パスワードが直書きされている）
# 175ファイル中174がリポジトリ直下。いずれも過去の緊急対応用で、
# ソースコードの一部ではない。共有リポジトリに含めてはならない。
/*.exp
/*.sh
/server/update-session-endpoints.sh
/URGENT_DEPLOYMENT_INSTRUCTIONS.md
/SYSTEM_RESTORE_GUIDE.md

# ログ（PII・トークンを含みうる）
logs/
**/logs/
*.log

# ビルド成果物・アーカイブ
/deploy-fix/
*.tar.gz
*.tgz

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
docker-compose.override.yml

# ------------------------------------------------------------------
# 配布リポジトリから除外する内部資料
# ------------------------------------------------------------------
# ルート直下の .md は緊急対応記録・ステータス報告などの内部作業ログで、
# サーバーIP・内部パス・社内向けの記述を含む。配布対象は allowlist のみ。
/*.md
!/README.md
!/API_DOCUMENTATION_SHAREGRAM.md

# docs/ も同様に、障害対応記録が大半のため allowlist 方式
/docs/*
!/docs/API_Reference_Final.md
!/docs/FIREBASE_SSO_GUIDE.md

# 入れ子の重複ディレクトリ（作業中に紛れ込んだもの）
/safevideo/

# 内部向けテストレポート
/server/tests/reports/

# SSH デプロイ用の expect スクリプト（サーバーIPを含む・配布対象外）
*.exp
# 障害対応ログ
/deployment-logs/
# 自社サーバーを指すCI設定・インフラ設定（配布先では使えない）
/.github/workflows/
/nginx-frontend.conf
/docker-compose.fixed.yml

# ★KYC本人確認書類（実在する個人の身分証・契約書・自撮り）
# 絶対にリポジトリに含めない
uploads/
**/uploads/
# 作業中の複製ディレクトリ
src.local.bak/
*.local.bak/

# Local secrets and generated files
.env
.env.*
.env *
!.env.example
!.env.*.example
!.env.*.template
cookies.txt
node_modules/
dist/
coverage/
*.pem
*.key
*serviceAccount*.json
*service-account*.json
firebase-adminsdk*.json

# 手元コピペで増える「一応とっておく」ファイル（レビュー対象外・実害ゼロだが
# 探索コストだけ上げる）。過去分は git 側にある。
*.backup
*.backup-*
*.backup.*
*.current-broken
*.fixed.jsx
*.hotfix.jsx
*.improved.js
*.improved.jsx
