# =============================================================================
#  FRONTEND  .env   (このファイルをリポジトリ直下の .env にコピーする)
#  npm run env:setup   でコピーできる
# =============================================================================
# Create React App は「この直下の .env」と「.env.<NODE_ENV>.local」だけを読む。
# server/.env とは別ファイル。変更後は npm start の再起動が必須（再ビルドではない）。

# 開発サーバーのポート。Sharegram から /sso に飛んでくる想定は :3300
PORT=3300

# -----------------------------------------------------------------------------
# ★最重要的: API の場所
# -----------------------------------------------------------------------------
# ここを決めると package.json の "proxy"（stg.id-manager.com）より先に決まる。
# 未設定のあいだ、フロントの /api 要求は package.json のプロキシ先＝**別DB**へ飛ぶ。
# 「SSO が成功したのにユーザーが居ない」「いつも Test User」は全部これ。
#   server で npm start した         → http://localhost:5000/api
#   docker-compose を使っている      → http://localhost:5002/api
REACT_APP_API_URL=http://localhost:5000/api

# API が Cookie を必要とする（CSRF / session）ため、開発時は http でも可。
# 本番ビルドでは https のサーバーからのみにする。
REACT_APP_SECURE_COOKIES=false

# -----------------------------------------------------------------------------
# Sharegram（戻り先・ログイン元）
# -----------------------------------------------------------------------------
# ローカルの Sharegram を立てていて、そちらに come_back する場合はその URL に変える
REACT_APP_SHAREGRAM_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Firebase（ブラウザ SDK。公開設定であり、秘密ではない）
# -----------------------------------------------------------------------------
# Sharegram と**同じプロジェクト**を指すこと。違うと token 検証が 400 になる。
# 値は Sharegram の firebaseConfig（または Firebase Console → Web アプリ設定）からコピーする。
REACT_APP_FIREBASE_PROJECT_ID=adroit-standard-496710-r5
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# 計測 ID（無いなら空のまま）
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Firebase Local Emulator を使うときだけ（本番ビルドでは必ず消す）
REACT_APP_USE_FIREBASE_EMULATOR=false

# -----------------------------------------------------------------------------
# 表示・サービスワーカー
# -----------------------------------------------------------------------------
# ビルド時にヘッダー等へ焼込む版数表示（未設定なら package.json の version）
REACT_APP_VERSION=
# 実行中の画面が古いキャッシュで迷子になるのを防ぐための SW。開発時は切っておく。
REACT_APP_ENABLE_SERVICE_WORKER=false

# -----------------------------------------------------------------------------
# CRA 自体が読むビルド調整（このアプリのコードは参照しない）
# -----------------------------------------------------------------------------
# 起動時にブラウザを自動で開かない（Windows で別ウィンドウが飛んで来るのを止める）
BROWSER=none
# ソースマップを作らない（ビルドが速くなり、成果物にソースが混ざらない）
GENERATE_SOURCEMAP=false
# runtime chunk を index.html にインライン化しない。
# バックエンドは CSP / security-headers を出しているので、インライン化すると
# 「本番だけ白画面」になりやすい。相対ディレクトリ配置の配信でもこれが必要。
INLINE_RUNTIME_CHUNK=false

# -----------------------------------------------------------------------------
# ⚠️ 常に false / 空のまま
# -----------------------------------------------------------------------------
# true にすると画面が「モック応答」に切り替わり、出演者登録も検証も**保存されない**
# （架空データと、bundle に埋め込まれた admin@example.com/admin123 のログインが
#  通ってしまう）。SSO の切り分け中に有効にしたなら、必ず元に戻すこと。
REACT_APP_USE_MOCK_API=false
