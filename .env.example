# SafeVideo Frontend Environment Configuration Example
# Copy this file to .env and update values for your environment
# NEVER commit .env file to version control

# ==========================================
# REACT APPLICATION SETTINGS
# ==========================================
NODE_ENV=development
REACT_APP_NAME=SafeVideo
REACT_APP_VERSION=1.0.0

# ==========================================
# API CONFIGURATION
# ==========================================
# Backend API URL (ensure correct port)
# 5002 = docker-compose (host) / nginx への本番・stg 向け。
# server/.env なしで `cd server && npm start` だけの場合は 5000 で待ち受ける
# （server.js: PORT = process.env.PORT || 5000）。起動ログの
# "Server running on port N" と必ず一致させること。
REACT_APP_API_URL=http://localhost:5002/api

# ==========================================
# FIREBASE CONFIGURATION (REQUIRED)
# ==========================================
# IMPORTANT: These values MUST be set for the application to work
# Get these values from your Firebase Console:
# https://console.firebase.google.com/project/YOUR-PROJECT/settings/general

# Firebase API Key - Found in Firebase Console > Project Settings
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key-here

# Firebase Auth Domain - Usually: your-project-id.firebaseapp.com
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# Firebase Project ID - Your unique project identifier
REACT_APP_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket - Usually: your-project-id.appspot.com
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firebase Messaging Sender ID - Numeric ID from Firebase Console
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789012

# Firebase App ID - Format: 1:sender-id:platform:app-id
REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abc123def456

# ==========================================
# FIREBASE EMULATOR (Development Only)
# ==========================================
# Set to 'true' to use Firebase Emulator Suite in development
REACT_APP_USE_FIREBASE_EMULATOR=false

# ==========================================
# SECURITY SETTINGS
# ==========================================
# Content Security Policy settings
REACT_APP_CSP_REPORT_URI=https://your-domain.com/csp-report

# Allowed domains for external resources (comma-separated)
REACT_APP_ALLOWED_DOMAINS=localhost,your-domain.com

# ==========================================
# FEATURE FLAGS
# ==========================================
# Enable/disable features
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_REPORTING=true
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true

# ==========================================
# THIRD-PARTY INTEGRATIONS
# ==========================================
# Sharegram Integration
REACT_APP_SHAREGRAM_API_URL=https://api.sharegram.com
REACT_APP_SHAREGRAM_CLIENT_ID=your-sharegram-client-id

# Sharegram SSO Configuration (Backend)
# JWKS URI for JWT token verification
SHAREGRAM_JWKS_URI=https://api.sharegram.com/.well-known/jwks.json
# JWT Issuer (must match the 'iss' claim in JWT)
SHAREGRAM_ISSUER=https://api.sharegram.com
# JWT Audience (must match the 'aud' claim in JWT)
SHAREGRAM_AUDIENCE=your-app-client-id
# Sharegram API Key for backend integration
SHAREGRAM_API_KEY=your-sharegram-api-key
# Webhook Secret for verifying Sharegram webhooks
SHAREGRAM_WEBHOOK_SECRET=your-webhook-secret-key

# ------------------------------------------------------------
# Sharegram SSO (Firebase ID Token) — 必須
# ------------------------------------------------------------
# /sso?token=... で受け取るトークンは Sharegram の Firebase プロジェクトが
# 発行します。サーバーが別のプロジェクトで初期化されていると、検証は必ず
# 失敗して 400 INVALID_TOKEN（画面では「Invalid token」）になります。
# 詳細は .env.firebase.example を参照。
FIREBASE_PROJECT_ID=adroit-standard-496710-r5
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@adroit-standard-496710-r5.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------
# Sharegram アカウント名の補完（任意）
# ------------------------------------------------------------
# Firebase ID Token には email しか入っていないことが多く、そのままだと
# ユーザー名がメールのローカル部（例: makara@gmail.com → "makara"）になります。
# 以下を設定すると、SSO時に Sharegram のアカウント情報（account_name /
# first_name / last_name / id）を取得して表示名と sharegramUserId を保存します。
# 未設定・取得失敗でもログインは成功します（名前だけメール由来になる）。
# SHAREGRAM_ACCOUNT_API_URL=https://api.share-gram.com/api/v2
# SHAREGRAM_ACCOUNT_PATH=/accounts/search
# SHAREGRAM_ACCOUNT_TIMEOUT_MS=5000

# ------------------------------------------------------------
# ローカル開発でフロント(:3300)からローカルAPI(:5000)を叩く場合
# ------------------------------------------------------------
# package.json の "proxy" は stg.id-manager.com を向いています。ローカルの
# サーバーでSSOをテストしたいときは、フロントの .env に次を設定してください。
# （サーバー側CORSは http://localhost:3300 を既に許可しています）
# REACT_APP_API_URL=http://localhost:5000/api   # `npm start` のみ（Docker なし）の場合
# REACT_APP_API_URL=http://localhost:5002/api   # docker-compose を使う場合（5002:5000）

# ------------------------------------------------------------
# 管理者シード（npm run seed）
# ------------------------------------------------------------
# SSOが作るユーザーは role='user'。performers の作成/一覧/書類確認はそれで足ります。
# approve・/api/v1（analytics, bulk, batch, integrations）・管理ナビを使う人だけを
# 以下に列挙して昇格してください。未設定なら seed は何もせず終わります。
# 認証情報は書かない（パスワードはランダム生成＝SSO専用アカウントになります）。
# SEED_ADMIN_EMAIL=makara@gmail.com
# SEED_ADMIN_ROLE=admin
# SEED_ADMIN_NAME=Makara

# 注意: npm run db:reset は db:drop を含むため、対象DBの全行が消えます。

# ==========================================
# DEVELOPMENT SETTINGS
# ==========================================
# Browser settings for development
BROWSER=none
REACT_APP_DEBUG_MODE=false

# ==========================================
# BUILD SETTINGS
# ==========================================
# Advanced build settings (usually not needed)
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false

# ==========================================
# IMPORTANT SECURITY NOTES
# ==========================================
# 1. NEVER commit actual API keys or secrets to version control
# 2. Use different Firebase projects for development/staging/production
# 3. Enable Firebase App Check for additional security
# 4. Restrict API key usage in Google Cloud Console:
#    - Application restrictions (HTTP referrers)
#    - API restrictions (only required Firebase APIs)
# 5. Monitor Firebase usage and set up budget alerts
# 6. Regularly rotate API keys and update them in production
# 7. Use environment-specific .env files:
#    - .env.development
#    - .env.staging  
#    - .env.production

# ==========================================
# FIREBASE SECURITY CHECKLIST
# ==========================================
# Before deploying to production, ensure:
# [ ] API keys are properly restricted in Google Cloud Console
# [ ] Firebase Security Rules are properly configured
# [ ] Firebase App Check is enabled
# [ ] HTTPS is enforced for all production deployments
# [ ] Environment variables are securely managed in CI/CD
# [ ] No sensitive data is logged to console in production
# [ ] Firebase project has appropriate IAM permissions
# [ ] Monitoring and alerting are configured