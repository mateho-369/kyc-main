# Local frontend only. npm run env:setup creates .env without replacing values.
# Relative URLs preserve same-origin cookies through CRA's local backend proxy.
PORT=3000
REACT_APP_API_URL=/api
REACT_APP_SECURE_COOKIES=false
REACT_APP_ENABLE_SERVICE_WORKER=false
# Fill from your authorized shared Firebase TEST project's Web App settings.
# These are public web configuration, NEVER an Admin SDK service-account key.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=
# Explicitly configure authorized Sharegram URLs if using that integration.
REACT_APP_SHAREGRAM_URL=
REACT_APP_SHAREGRAM_LOGIN_URL=
REACT_APP_SHAREGRAM_RETURN_URL=
BROWSER=none
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false
