# ============================================================
# Sharegram SSO / Firebase 設定
# ============================================================
# 【重要】SSOで受け取る Firebase ID Token は Sharegram の Firebase
# プロジェクト（adroit-standard-496710-r5）が発行します。
# サーバー側が *別の* プロジェクトのサービスアカウントで初期化されていると、
# admin.auth().verifyIdToken() が必ず失敗し、SSOは
#   400 { code: 'INVALID_TOKEN' }  → 「Invalid token」
# になります。旧プロジェクト singular-winter-370002 を残さないこと。
#
# 確認方法: /sso?token=... のトークンを jwt.io で開き、"iss" が
#   https://securetoken.google.com/adroit-standard-496710-r5
# になっていること。FIREBASE_PROJECT_ID はこれと一致している必要があります。

# Firebase Configuration (for React App)
REACT_APP_FIREBASE_API_KEY=AIzaSyC9pSqeZeOjvndPX_dPEsaIU22CUWVYB_0
REACT_APP_FIREBASE_AUTH_DOMAIN=adroit-standard-496710-r5.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=adroit-standard-496710-r5
REACT_APP_FIREBASE_STORAGE_BUCKET=adroit-standard-496710-r5.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=716516303448
REACT_APP_FIREBASE_APP_ID=1:716516303448:web:e7ab0a08b087ffd60f602d

# Firebase Admin SDK (for Backend) — must be a service account of the SAME
# project as above (Firebase Console > Project settings > Service accounts)
FIREBASE_PROJECT_ID=adroit-standard-496710-r5
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@adroit-standard-496710-r5.iam.gserviceaccount.com

# Additional Firebase Configuration (for compatibility)
FIREBASE_API_KEY=AIzaSyC9pSqeZeOjvndPX_dPEsaIU22CUWVYB_0
FIREBASE_AUTH_DOMAIN=adroit-standard-496710-r5.firebaseapp.com

# 開発時に Firebase を無効化すると SSO は 503 FIREBASE_NOT_CONFIGURED を返します
# （以前のように test@example.com の "Test User" でログインさせることはありません）
# DISABLE_FIREBASE=false
